# 复制为 .env 后填写真实值；.env 已被 git 忽略，不要提交密钥。

# OpenAI-compatible vision model
VISION_BASE_URL=https://api.siliconflow.cn/v1
VISION_MODEL=Qwen/Qwen3-VL-30B-A3B-Thinking
VISION_API_KEY=

# Dify hazard rules knowledge-base API
DIFY_BASE_URL=http://172.20.1.81/v1
DIFY_API_KEY=
DIFY_HAZARD_RULES_DATASET_ID=d046ad37-46bf-47cb-ba68-badab9c9b002

# 默认不继承系统 HTTP_PROXY/HTTPS_PROXY，避免失效代理导致视觉模型 502；需要代理时改为 true。
UPSTREAM_TRUST_ENV=false

# Optional API protection
API_AUTH_TOKEN=
CORS_ORIGIN=*
